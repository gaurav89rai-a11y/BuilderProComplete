<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BuilderProDataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLEXPRESS;Initial Catalog=BuilderProDB;Integrated Security=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>e1a2b3c4-0005-4000-8000-000000000005</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="UnitInventoryDataSet">
      <Query>
        <DataSourceName>BuilderProDataSource</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>sp_Rpt_UnitInventoryStatus</CommandText>
        <QueryParameters>
          <QueryParameter Name="@ProjectId"><Value>=Parameters!ProjectId.Value</Value></QueryParameter>
          <QueryParameter Name="@Status"><Value>=Parameters!Status.Value</Value></QueryParameter>
          <QueryParameter Name="@UnitType"><Value>=Parameters!UnitType.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="UnitId"><DataField>UnitId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="UnitNumber"><DataField>UnitNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProjectName"><DataField>ProjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProjectLocation"><DataField>ProjectLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="UnitType"><DataField>UnitType</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Floor"><DataField>Floor</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="CarpetAreaSqFt"><DataField>CarpetAreaSqFt</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="UnitStatus"><DataField>UnitStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="OccupantCustomer"><DataField>OccupantCustomer</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="ProjectId"><DataType>Integer</DataType><Nullable>true</Nullable><Prompt>Project ID</Prompt></ReportParameter>
    <ReportParameter Name="Status"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Unit Status</Prompt></ReportParameter>
    <ReportParameter Name="UnitType"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Unit Typology</Prompt></ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="HeaderTitle">
            <Top>0.2in</Top><Left>0.2in</Left><Height>0.35in</Height><Width>8.0in</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>UNIT INVENTORY &amp; AVAILABILITY MATRIX REPORT</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#B8860B</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Tablix Name="UnitTablix">
            <Top>0.7in</Top><Left>0.2in</Left><Height>0.6in</Height><Width>8.0in</Width>
            <DataSetName>UnitInventoryDataSet</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>1.1in</Width></TablixColumn>
                <TablixColumn><Width>1.6in</Width></TablixColumn>
                <TablixColumn><Width>0.9in</Width></TablixColumn>
                <TablixColumn><Width>0.6in</Width></TablixColumn>
                <TablixColumn><Width>1.0in</Width></TablixColumn>
                <TablixColumn><Width>1.4in</Width></TablixColumn>
                <TablixColumn><Width>1.4in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="H_Unit"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Unit No.</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor><PaddingLeft>4pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Project"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Project</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Type"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Type</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Floor"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Floor</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Area"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Area (sqft)</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><TextAlign>Right</TextAlign></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Price"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Base Price (₹)</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><TextAlign>Right</TextAlign></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Status"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs><Style><BackgroundColor>#1A1D24</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="D_Unit"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!UnitNumber.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>SemiBold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><PaddingLeft>4pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Project"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ProjectName.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Type"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!UnitType.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Floor"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Floor.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Area"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!CarpetAreaSqFt.Value, "##,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><TextAlign>Right</TextAlign></Paragraph></Paragraphs><Style><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Price"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!UnitPrice.Value, "##,##,##,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>SemiBold</FontWeight></Style></TextRun></TextRuns><TextAlign>Right</TextAlign></Paragraph></Paragraphs><Style><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="D_Status"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!UnitStatus.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>=IIf(Fields!UnitStatus.Value="Available", "#008080", IIf(Fields!UnitStatus.Value="Booked", "#B8860B", "#999999"))</Color></Style></TextRun></TextRuns><TextAlign>Center</TextAlign></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy><TablixMembers><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/></TablixMembers></TablixColumnHierarchy>
            <TablixRowHierarchy><TablixMembers><TablixMember/><TablixMember><Group Name="UnitDetails"/></TablixMember></TablixMembers></TablixRowHierarchy>
          </Tablix>
        </ReportItems>
        <Height>3.5in</Height>
      </Body>
      <Width>8.5in</Width>
      <Page>
        <PageHeight>11.0in</PageHeight><PageWidth>8.5in</PageWidth>
        <LeftMargin>0.25in</LeftMargin><RightMargin>0.25in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
